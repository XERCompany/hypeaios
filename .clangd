CompileFlags:
  Add:
    - --target=x86_64-unknown-none-elf
    - -std=c++20
    - -ffreestanding
    - -fno-exceptions
    - -fno-rtti
    - -fno-pic
    - -fno-pie
    - -mno-red-zone
    - -m64
    - -mcmodel=large
    - -I.
    - -isystem
    - third_party/sqlite
Diagnostics:
  MissingIncludes: Strict
